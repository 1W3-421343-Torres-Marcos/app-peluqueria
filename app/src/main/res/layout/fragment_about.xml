<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_l">

    <com.metanoia.app.ui.common.LogoView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:logoSize="splash" />

    <TextView
        android:id="@+id/aboutVersionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:textAppearance="@style/TextAppearance.Metanoia.Subtitle"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:gravity="center"
        android:text="@string/about_offline_note"
        android:textAppearance="@style/TextAppearance.Metanoia.BodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
