<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cash_closing_dialog_title"
            android:textAppearance="@style/TextAppearance.Metanoia.Headline"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/closingDateSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.Metanoia.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Efectivo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/cash_method_cash"
            android:textAppearance="@style/TextAppearance.Metanoia.Subtitle"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/closingCashExpected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Metanoia.Caption"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:hint="@string/cash_closing_counted_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputClosingCashCounted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/closingCashDiff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.Metanoia.Caption"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Transferencia -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/cash_method_transfer"
            android:textAppearance="@style/TextAppearance.Metanoia.Subtitle"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/closingTransferExpected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Metanoia.Caption"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:hint="@string/cash_closing_counted_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputClosingTransferCounted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/closingTransferDiff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.Metanoia.Caption"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Tarjeta -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/cash_method_card"
            android:textAppearance="@style/TextAppearance.Metanoia.Subtitle"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/closingCardExpected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Metanoia.Caption"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:hint="@string/cash_closing_counted_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputClosingCardCounted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/closingCardDiff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.Metanoia.Caption"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Mercado Pago -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/cash_method_mercado_pago"
            android:textAppearance="@style/TextAppearance.Metanoia.Subtitle"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/closingMercadoPagoExpected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Metanoia.Caption"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:hint="@string/cash_closing_counted_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputClosingMercadoPagoCounted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/closingMercadoPagoDiff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.Metanoia.Caption"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_width"
            android:layout_marginVertical="@dimen/space_m"
            android:background="@color/divider_subtle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cash_closing_total_expected"
                android:textAppearance="@style/TextAppearance.Metanoia.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.metanoia.app.ui.common.MoneyTextView
                android:id="@+id/closingTotalExpected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cash_closing_total_counted"
                android:textAppearance="@style/TextAppearance.Metanoia.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.metanoia.app.ui.common.MoneyTextView
                android:id="@+id/closingTotalCounted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cash_closing_total_diff"
                android:textAppearance="@style/TextAppearance.Metanoia.Subtitle"
                android:textColor="?attr/colorOnSurface" />

            <com.metanoia.app.ui.common.MoneyTextView
                android:id="@+id/closingTotalDiff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:hint="@string/cash_closing_notes_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputClosingNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="240" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmCashClosing"
            style="@style/Widget.Metanoia.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/cash_closing_confirm_btn" />
    </LinearLayout>
</ScrollView>
