<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/moreContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/more_appearance_title"
            android:textAppearance="@style/TextAppearance.Metanoia.Title"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/themeToggleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnThemeSystem"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/theme_mode_system" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnThemeLight"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/theme_mode_light" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnThemeDark"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/theme_mode_dark" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.metanoia.app.ui.common.ListRowView
            android:id="@+id/rowServices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            app:rowShowChevron="true"
            app:rowShowDivider="true"
            app:rowSubtitle="@string/more_services_subtitle"
            app:rowTitle="@string/more_services_title" />

        <com.metanoia.app.ui.common.ListRowView
            android:id="@+id/rowProfessionals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowShowChevron="true"
            app:rowShowDivider="true"
            app:rowSubtitle="@string/more_professionals_subtitle"
            app:rowTitle="@string/more_professionals_title" />

        <com.metanoia.app.ui.common.ListRowView
            android:id="@+id/rowSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowShowChevron="true"
            app:rowShowDivider="true"
            app:rowSubtitle="@string/more_settings_subtitle"
            app:rowTitle="@string/more_settings_title" />

        <com.metanoia.app.ui.common.ListRowView
            android:id="@+id/rowBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowShowChevron="true"
            app:rowShowDivider="true"
            app:rowSubtitle="@string/more_backup_subtitle"
            app:rowTitle="@string/more_backup_title" />

        <com.metanoia.app.ui.common.ListRowView
            android:id="@+id/rowReminders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowShowChevron="true"
            app:rowShowDivider="true"
            app:rowSubtitle="@string/more_reminders_subtitle"
            app:rowTitle="@string/more_reminders_title" />

        <com.metanoia.app.ui.common.ListRowView
            android:id="@+id/rowWaitlist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowShowChevron="true"
            app:rowShowDivider="true"
            app:rowSubtitle="@string/more_waitlist_subtitle"
            app:rowTitle="@string/more_waitlist_title" />

        <com.metanoia.app.ui.common.ListRowView
            android:id="@+id/rowAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowShowChevron="true"
            app:rowShowDivider="true"
            app:rowSubtitle="@string/more_about_subtitle"
            app:rowTitle="@string/more_about_title" />

        <com.metanoia.app.ui.common.ListRowView
            android:id="@+id/rowComponentCatalog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:rowShowChevron="true"
            app:rowShowDivider="true"
            app:rowSubtitle="@string/more_catalog_subtitle"
            app:rowTitle="@string/more_catalog_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/more_upcoming_modules"
            android:textAppearance="@style/TextAppearance.Metanoia.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</ScrollView>
