<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/searchFieldIcon"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:layout_marginStart="@dimen/space_m"
        android:contentDescription="@string/cd_search_icon"
        android:src="@drawable/ic_search"
        app:tint="?attr/colorOnSurfaceVariant" />

    <EditText
        android:id="@+id/searchFieldInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@null"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:minHeight="@dimen/touch_target_min"
        android:paddingHorizontal="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.Metanoia.Body"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/colorOnSurfaceVariant" />

    <ImageButton
        android:id="@+id/searchFieldClear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_search_clear"
        android:minWidth="@dimen/touch_target_min"
        android:minHeight="@dimen/touch_target_min"
        android:src="@drawable/ic_close"
        android:visibility="gone"
        app:tint="?attr/colorOnSurfaceVariant" />
</merge>
