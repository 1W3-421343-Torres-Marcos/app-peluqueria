<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/screen_margin">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/waitlist_suggestions_title"
        android:textAppearance="@style/TextAppearance.Metanoia.Headline"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/txtSuggestionsSlotSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.Metanoia.BodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/waitlistSuggestionsRecycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:nestedScrollingEnabled="true" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIgnoreWaitlistSuggestions"
        style="@style/Widget.Metanoia.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:text="@string/waitlist_suggestion_ignore_btn" />
</LinearLayout>
