<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Metanoia" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_light</item>
        <item name="colorOnSecondary">@color/on_accent_light</item>
        <item name="colorSecondaryContainer">@color/accent_container_light</item>
        <item name="colorOnSecondaryContainer">@color/accent_light</item>

        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceContainer">@color/gray50</item>
        <item name="colorSurfaceVariant">@color/gray50</item>
        <item name="colorOutline">@color/gray200</item>
        <item name="colorOutlineVariant">@color/gray100</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/gray600</item>
        <item name="colorError">@color/accent_light</item>
        <item name="colorOnError">@color/on_accent_light</item>

        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="textAppearanceBodyLarge">@style/TextAppearance.Metanoia.Body</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Metanoia.BodySmall</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Metanoia.Caption</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Metanoia.Label</item>
    </style>

    <style name="Theme.Metanoia.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Metanoia</item>
    </style>
</resources>
