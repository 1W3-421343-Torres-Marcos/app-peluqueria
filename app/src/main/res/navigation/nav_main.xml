<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_main"
    app:startDestination="@id/nav_agenda">

    <fragment
        android:id="@+id/nav_agenda"
        android:name="com.metanoia.app.ui.agenda.AgendaFragment"
        android:label="@string/nav_agenda">
        <action
            android:id="@+id/action_agenda_to_create"
            app:destination="@id/nav_appointment_create" />
        <action
            android:id="@+id/action_agenda_to_detail"
            app:destination="@id/nav_appointment_detail" />
        <action
            android:id="@+id/action_agenda_to_blocks"
            app:destination="@id/nav_schedule_blocks" />
        <action
            android:id="@+id/action_agenda_to_backup"
            app:destination="@id/nav_backup" />
        <action
            android:id="@+id/action_agenda_to_reminders"
            app:destination="@id/nav_reminders" />
        <action
            android:id="@+id/action_agenda_to_waitlist"
            app:destination="@id/nav_waitlist" />
        <action
            android:id="@+id/action_agenda_to_stock"
            app:destination="@id/nav_stock" />
    </fragment>

    <fragment
        android:id="@+id/nav_appointment_create"
        android:name="com.metanoia.app.ui.agenda.create.AppointmentCreateFragment"
        android:label="@string/appointment_create_title" />

    <fragment
        android:id="@+id/nav_appointment_detail"
        android:name="com.metanoia.app.ui.agenda.detail.AppointmentDetailFragment"
        android:label="@string/appointment_detail_title" />

    <fragment
        android:id="@+id/nav_schedule_blocks"
        android:name="com.metanoia.app.ui.agenda.blocks.ScheduleBlocksFragment"
        android:label="@string/schedule_blocks_title" />

    <fragment
        android:id="@+id/nav_clients"
        android:name="com.metanoia.app.ui.clients.ClientsFragment"
        android:label="@string/nav_clients">
        <action
            android:id="@+id/action_clients_to_detail"
            app:destination="@id/nav_client_detail" />
    </fragment>

    <fragment
        android:id="@+id/nav_client_detail"
        android:name="com.metanoia.app.ui.clients.ClientDetailFragment"
        android:label="@string/client_detail_title" />

    <fragment
        android:id="@+id/nav_cash"
        android:name="com.metanoia.app.ui.cash.CashFragment"
        android:label="@string/nav_cash">
        <action
            android:id="@+id/action_cash_to_receivables"
            app:destination="@id/nav_receivables" />
    </fragment>

    <fragment
        android:id="@+id/nav_receivables"
        android:name="com.metanoia.app.ui.cash.receivables.ReceivablesFragment"
        android:label="@string/receivables_title" />

    <fragment
        android:id="@+id/nav_more"
        android:name="com.metanoia.app.ui.more.MoreFragment"
        android:label="@string/nav_more">
        <action
            android:id="@+id/action_more_to_services"
            app:destination="@id/nav_services" />
        <action
            android:id="@+id/action_more_to_professionals"
            app:destination="@id/nav_professionals" />
        <action
            android:id="@+id/action_more_to_settings"
            app:destination="@id/nav_settings" />
        <action
            android:id="@+id/action_more_to_backup"
            app:destination="@id/nav_backup" />
        <action
            android:id="@+id/action_more_to_reminders"
            app:destination="@id/nav_reminders" />
        <action
            android:id="@+id/action_more_to_waitlist"
            app:destination="@id/nav_waitlist" />
        <action
            android:id="@+id/action_more_to_stock"
            app:destination="@id/nav_stock" />
        <action
            android:id="@+id/action_more_to_commissions"
            app:destination="@id/nav_commissions" />
        <action
            android:id="@+id/action_more_to_reports"
            app:destination="@id/nav_reports" />
        <action
            android:id="@+id/action_more_to_about"
            app:destination="@id/nav_about" />
        <action
            android:id="@+id/action_more_to_catalog"
            app:destination="@id/nav_component_catalog" />
    </fragment>

    <fragment
        android:id="@+id/nav_services"
        android:name="com.metanoia.app.ui.services.ServicesFragment"
        android:label="@string/services_title" />

    <fragment
        android:id="@+id/nav_professionals"
        android:name="com.metanoia.app.ui.professionals.ProfessionalsFragment"
        android:label="@string/professionals_title">
        <action
            android:id="@+id/action_professionals_to_form"
            app:destination="@id/nav_professional_form" />
    </fragment>

    <fragment
        android:id="@+id/nav_professional_form"
        android:name="com.metanoia.app.ui.professionals.ProfessionalFormFragment"
        android:label="@string/professionals_title" />

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.metanoia.app.ui.settings.SettingsFragment"
        android:label="@string/settings_title">
        <action
            android:id="@+id/action_settings_to_templates"
            app:destination="@id/nav_templates" />
    </fragment>

    <fragment
        android:id="@+id/nav_templates"
        android:name="com.metanoia.app.ui.settings.TemplatesFragment"
        android:label="@string/templates_title" />

    <fragment
        android:id="@+id/nav_backup"
        android:name="com.metanoia.app.ui.backup.BackupFragment"
        android:label="@string/backup_title" />

    <fragment
        android:id="@+id/nav_reminders"
        android:name="com.metanoia.app.ui.reminders.RemindersFragment"
        android:label="@string/reminders_title" />

    <fragment
        android:id="@+id/nav_waitlist"
        android:name="com.metanoia.app.ui.waitlist.WaitlistFragment"
        android:label="@string/waitlist_title" />

    <fragment
        android:id="@+id/nav_stock"
        android:name="com.metanoia.app.ui.stock.StockFragment"
        android:label="@string/stock_title">
        <action
            android:id="@+id/action_stock_to_product_detail"
            app:destination="@id/nav_product_detail" />
    </fragment>

    <fragment
        android:id="@+id/nav_product_detail"
        android:name="com.metanoia.app.ui.stock.movements.ProductDetailFragment"
        android:label="@string/product_detail_title" />

    <fragment
        android:id="@+id/nav_commissions"
        android:name="com.metanoia.app.ui.commissions.CommissionsFragment"
        android:label="@string/commissions_title" />

    <fragment
        android:id="@+id/nav_reports"
        android:name="com.metanoia.app.ui.reports.ReportsFragment"
        android:label="@string/reports_title" />

    <fragment
        android:id="@+id/nav_about"
        android:name="com.metanoia.app.ui.settings.AboutFragment"
        android:label="@string/about_title" />

    <fragment
        android:id="@+id/nav_component_catalog"
        android:name="com.metanoia.app.ui.debug.ComponentCatalogFragment"
        android:label="@string/catalog_title" />
</navigation>
