<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_main"
    app:startDestination="@id/nav_agenda">

    <fragment
        android:id="@+id/nav_agenda"
        android:name="com.metanoia.app.ui.agenda.AgendaFragment"
        android:label="@string/nav_agenda" />

    <fragment
        android:id="@+id/nav_clients"
        android:name="com.metanoia.app.ui.clients.ClientsFragment"
        android:label="@string/nav_clients" />

    <fragment
        android:id="@+id/nav_cash"
        android:name="com.metanoia.app.ui.cash.CashFragment"
        android:label="@string/nav_cash" />

    <fragment
        android:id="@+id/nav_more"
        android:name="com.metanoia.app.ui.more.MoreFragment"
        android:label="@string/nav_more">
        <action
            android:id="@+id/action_more_to_settings"
            app:destination="@id/nav_settings" />
        <action
            android:id="@+id/action_more_to_about"
            app:destination="@id/nav_about" />
        <action
            android:id="@+id/action_more_to_catalog"
            app:destination="@id/nav_component_catalog" />
    </fragment>

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.metanoia.app.ui.settings.SettingsFragment"
        android:label="@string/settings_title" />

    <fragment
        android:id="@+id/nav_about"
        android:name="com.metanoia.app.ui.settings.AboutFragment"
        android:label="@string/about_title" />

    <fragment
        android:id="@+id/nav_component_catalog"
        android:name="com.metanoia.app.ui.debug.ComponentCatalogFragment"
        android:label="@string/catalog_title" />
</navigation>
